---
import Menu from "./Menu.astro";
---

<header class="header">
  <Menu />
</header>

<style>
  .header {
    display: flex;
    justify-content: flex-end;
    max-width: 70rem;
    padding-block: 2.5rem 1.5rem;
    padding-inline: 1.5rem;
    margin-inline: auto;
  }

  @media screen and (width <= 40rem) {
    .header {
      position: relative;
      z-index: 30;
      padding-block: 1.25rem;
    }
  }
</style>
